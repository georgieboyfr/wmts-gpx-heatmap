# Copie ce fichier en .env (jamais commité) et renseigne tes valeurs.

# Jeton exigé par les endpoints /admin/* (en-tête "Authorization: Bearer <jeton>").
# Sans lui, ces endpoints sont désactivés. Générer par ex. avec : openssl rand -hex 32
ADMIN_TOKEN=

# Utilisateur/groupe propriétaires des dossiers de données montés (commande `id` sur le NAS)
PUID=1000
PGID=1000

# Garmin Connect : le compte se connecte depuis l'admin (onglet Garmin). Facultatif :
# ces variables jouent le rôle d'un mot de passe mémorisé (reconnexion automatique).
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_STORE=/data/garmin_tokens
